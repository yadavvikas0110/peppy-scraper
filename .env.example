# Placeholders only — never commit real values. Copy to .env and fill in.

# ─── Module 1: e-commerce scraper (src/index.ts) ─────────────────────────────
PORT=4000
BRIGHT_DATA_API_KEY=
BRIGHT_DATA_UNLOCKER_ZONE=
# Format: brd-customer-XXXXXXX-zone-ZONENAME:PASSWORD
BRIGHT_DATA_BROWSER_AUTH=
BD_BROWSER_CONCURRENCY=1
BD_UNLOCKER_CONCURRENCY=1
PARALLEL_QUERIES=
OPENAI_API_KEY=
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=
MONGODB_URI=
ENABLE_CRON=false
SCRAPE_CRON=0 2 * * *
PEPPY_BE_URL=

# ─── Module 2: dining scraper (src/dining-server.ts) ─────────────────────────
DINING_PORT=4001
# Required for future dining scrape endpoints (sent as the x-api-key header). /health is public.
DINING_API_KEY=

# MongoDB for dining_* collections reuses MONGODB_URI above.
# Database precedence: MONGODB_DB → database in MONGODB_URI path → "peppy" (same as Module 1).
# MONGODB_DB=peppy

# Scrape.do — required only when the Scrape.do client is used (not for /health)
SCRAPE_DO_TOKEN=
SCRAPE_DO_BASE_URL=https://api.scrape.do/
# Local HTTP timeout in ms (5000–300000). Keep above Scrape.do's own 60000ms request timeout.
SCRAPE_DO_TIMEOUT_MS=90000
# Max concurrent Scrape.do requests from the dining service (1–100). Keep within your plan limit.
SCRAPE_DO_CONCURRENCY=2
# Client-side retries for timeout/network/429/5xx only (0–5). Each retry may consume credits.
SCRAPE_DO_MAX_RETRIES=2
