# Placeholders only — never commit real values. Copy to .env and fill in.

# ─── Module 1: e-commerce scraper (src/index.ts) ─────────────────────────────
PORT=4000
BRIGHT_DATA_API_KEY=
BRIGHT_DATA_UNLOCKER_ZONE=
# Format: brd-customer-XXXXXXX-zone-ZONENAME:PASSWORD
BRIGHT_DATA_BROWSER_AUTH=
BD_BROWSER_CONCURRENCY=1
BD_UNLOCKER_CONCURRENCY=1
PARALLEL_QUERIES=
OPENAI_API_KEY=
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=
MONGODB_URI=
# Products are written to: MONGODB_DB → database in MONGODB_URI path → "peppy"
# MONGODB_DB=
ENABLE_CRON=false
SCRAPE_CRON=0 2 * * *
PEPPY_BE_URL=
# Shared secret (x-api-key) for every route except "/" and for /ws/logs (?key=).
# Set the same value as SCRAPER_API_KEY in peppy-be (also required for post-push mapping). Unset = endpoints are open.
SCRAPER_API_KEY=
# Resume state and per-query checkpoints older than this are discarded (their prices are a previous day's).
# CHECKPOINT_MAX_AGE_HOURS overrides it for checkpoints only.
CRON_STATE_MAX_AGE_HOURS=20
# Offers this scraper wrote that no run has seen for this many days become stale: stock unknown, out of the price range
STALE_OFFER_DAYS=3
# Sites listed here are scraped even though Bright Data refused them before (robots.txt/KYC).
# Set ONLY after Bright Data has approved access for the domain, e.g. BRIGHT_DATA_APPROVED_SITES=noon
BRIGHT_DATA_APPROVED_SITES=
# After each push the scraper calls PEPPY_BE_URL/api/v1/admin/scraper/ingest/apply-mapping with SCRAPER_API_KEY
# to map categories / product roles / variant groups. Without both, products stay ingestMappingStatus=pending.

# ─── Shopping worker (src/worker — Amazon UAE discovery + refresh) ───────────
# development (default) refuses a production database; production also needs CONFIRM_PRODUCTION_DB=yes
SHOPPING_WORKER_ENV=development
# Only "amazon" (Amazon UAE) is supported; noon is refused until BRIGHT_DATA_APPROVED_SITES includes it
SHOPPING_SITES=amazon
# Discovery queries (JSON); defaults to config/shopping-queries.json
# SHOPPING_QUERIES_FILE=
SHOPPING_DISCOVERY_INTERVAL_HOURS=24
SHOPPING_REFRESH_INTERVAL_HOURS=12
# Offers observed more recently than this are neither refreshed nor re-scraped by discovery
SHOPPING_FRESH_FOR_HOURS=12
SHOPPING_REFRESH_BATCH_SIZE=100
# Paid Bright Data requests per UTC day across all worker jobs (shared by every worker process)
SHOPPING_DAILY_REQUEST_BUDGET=800
SHOPPING_MIN_REQUEST_INTERVAL_MS=2000
SHOPPING_MAX_CONCURRENCY=2
SHOPPING_WORKER_TICK_SECONDS=60
SHOPPING_RETRY_BASE_MINUTES=15
SHOPPING_MAX_ATTEMPTS=4
SHOPPING_LOCK_TTL_MINUTES=10
# Unlocker exit country for amazon.ae (UAE location, AED prices)
AMAZON_UNLOCKER_COUNTRY=ae
# The worker refuses to start while ENABLE_CRON=true (two scraping loops) unless this is "yes"
# SHOPPING_WORKER_ALLOW_LEGACY_CRON=

# ─── Module 2: dining scraper (src/dining-server.ts) ─────────────────────────
DINING_PORT=4001
# Required for future dining scrape endpoints (sent as the x-api-key header). /health is public.
DINING_API_KEY=

# MongoDB for dining_* collections reuses MONGODB_URI above.
# Database precedence: MONGODB_DB → database in MONGODB_URI path → "peppy" (same as Module 1).
# MONGODB_DB=peppy

# Scrape.do — required only when the Scrape.do client is used (not for /health)
SCRAPE_DO_TOKEN=
SCRAPE_DO_BASE_URL=https://api.scrape.do/
# Local HTTP timeout in ms (5000–300000). Keep above Scrape.do's own 60000ms request timeout.
SCRAPE_DO_TIMEOUT_MS=90000
# Max concurrent Scrape.do requests from the dining service (1–100). Keep within your plan limit.
SCRAPE_DO_CONCURRENCY=2
# Client-side retries for timeout/network/429/5xx only (0–5). Each retry may consume credits.
SCRAPE_DO_MAX_RETRIES=2

# ─── S3 image storage (src/utils/s3.util.ts) ────────────────────────────────
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
S3_BUCKET=
CDN_URL=
